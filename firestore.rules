rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isAuth() && myRole() == 'SUPER_ADMIN';
    }

    function isTrainingProvider() {
      return isAuth() && myRole() == 'TRAINING_PROVIDER';
    }

    // ── user_profiles ─────────────────────────────────────────
    match /user_profiles/{uid} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow read, write: if isSuperAdmin();
      allow read: if isTrainingProvider();
      allow create: if isAuth() && request.auth.uid == uid;
    }

    // ── organizations ─────────────────────────────────────────
    match /organizations/{orgId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    // ── training_requests ─────────────────────────────────────
    match /training_requests/{reqId} {
      allow read: if isSuperAdmin() || isTrainingProvider();
      allow create: if isAuth();
      allow update: if isSuperAdmin() || isTrainingProvider();
      allow delete: if isSuperAdmin();
    }

    // ── certificates ──────────────────────────────────────────
    match /certificates/{certId} {
      allow read: if isAuth();
      allow create, update: if isSuperAdmin() || isTrainingProvider();
      allow delete: if isSuperAdmin();
    }

    // ── notifications (in-app) ────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuth() && (
        isSuperAdmin() ||
        (isTrainingProvider() && resource.data.recipientRole == 'TRAINING_PROVIDER') ||
        (request.auth.uid == resource.data.recipientUid)
      );
      allow create: if isSuperAdmin() || isTrainingProvider();
      allow update: if isAuth() && (
        isSuperAdmin() ||
        (
          isTrainingProvider() &&
          resource.data.recipientRole == 'TRAINING_PROVIDER' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        ) ||
        (
          request.auth.uid == resource.data.recipientUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        )
      );
      allow delete: if isSuperAdmin();
    }

    // ── fleet_vehicles ────────────────────────────────────────
    // Reads: any authenticated user (onSnapshot works without role check)
    // Writes: myRole() checked only on write — no inter-doc read on plain reads
    match /fleet_vehicles/{vehicleId} {
      allow read:   if isAuth();
      allow create,
            update: if isAuth() && (myRole() == 'FLEET' || myRole() == 'SUPER_ADMIN');
      allow delete: if isSuperAdmin();
    }

    // ── fleet_inspections ─────────────────────────────────────
    match /fleet_inspections/{inspectionId} {
      allow read:   if isAuth();
      allow create,
            update: if isAuth() && (myRole() == 'FLEET' || myRole() == 'SUPER_ADMIN');
      allow delete: if isSuperAdmin();
    }

    // ── fleet_fuel_logs ───────────────────────────────────────
    match /fleet_fuel_logs/{logId} {
      allow read:   if isAuth();
      allow create,
            update: if isAuth() && (myRole() == 'FLEET' || myRole() == 'SUPER_ADMIN');
      allow delete: if isSuperAdmin();
    }

    // ── fleet_alerts ──────────────────────────────────────────
    match /fleet_alerts/{alertId} {
      allow read:   if isAuth();
      allow create,
            update: if isAuth() && (myRole() == 'FLEET' || myRole() == 'SUPER_ADMIN');
      allow delete: if isSuperAdmin();
    }

    // ── Fire Extinguisher Collections ─────────────────────────
    match /fe_assets/{assetId} {
      allow read:   if isAuth();
      allow create,
            update: if isAuth() && (myRole() == 'FIRE_EXTINGUISHER' || myRole() == 'SUPER_ADMIN');
      allow delete: if isSuperAdmin();
    }

    match /fe_inspections/{inspectionId} {
      allow read:   if isAuth();
      allow create,
            update: if isAuth() && (myRole() == 'FIRE_EXTINGUISHER' || myRole() == 'SUPER_ADMIN');
      allow delete: if isSuperAdmin();
    }

    match /fe_alerts/{alertId} {
      allow read:   if isAuth();
      allow create,
            update: if isAuth() && (myRole() == 'FIRE_EXTINGUISHER' || myRole() == 'SUPER_ADMIN');
      allow delete: if isSuperAdmin();
    }

    match /fe_activity_log/{logId} {
      allow read:   if isAuth();
      allow create: if isAuth() && (myRole() == 'FIRE_EXTINGUISHER' || myRole() == 'SUPER_ADMIN');
      allow update, delete: if isSuperAdmin();
    }

    match /fe_compliance_config/{configId} {
      allow read:   if isAuth() && (myRole() == 'FIRE_EXTINGUISHER' || myRole() == 'SUPER_ADMIN');
      allow create,
            update: if isAuth() && (myRole() == 'FIRE_EXTINGUISHER' || myRole() == 'SUPER_ADMIN');
      allow delete: if isSuperAdmin();
    }

    // ── Fire Detection Collections ───────────────────────────────
    match /fd_assets/{assetId} {
      allow read:   if isAuth();
      allow create,
            update: if isAuth() && (myRole() == 'FIRE_DETECTION' || myRole() == 'SUPER_ADMIN');
      allow delete: if isSuperAdmin();
    }

    match /fd_alerts/{alertId} {
      allow read:   if isAuth();
      allow create,
            update: if isAuth() && (myRole() == 'FIRE_DETECTION' || myRole() == 'SUPER_ADMIN');
      allow delete: if isSuperAdmin();
    }

    match /fd_activity_log/{logId} {
      allow read:   if isAuth();
      allow create: if isAuth() && (myRole() == 'FIRE_DETECTION' || myRole() == 'SUPER_ADMIN');
      allow update, delete: if isSuperAdmin();
    }

    match /fd_zones/{zoneId} {
      allow read:   if isAuth();
      allow create,
            update: if isAuth() && (myRole() == 'FIRE_DETECTION' || myRole() == 'SUPER_ADMIN');
      allow delete: if isSuperAdmin();
    }

    match /fd_panels/{panelId} {
      allow read:   if isAuth();
      allow create,
            update: if isAuth() && (myRole() == 'FIRE_DETECTION' || myRole() == 'SUPER_ADMIN');
      allow delete: if isSuperAdmin();
    }

    match /fd_system_metrics/{metricId} {
      allow read:   if isAuth();
      allow create,
            update: if isAuth() && (myRole() == 'FIRE_DETECTION' || myRole() == 'SUPER_ADMIN');
      allow delete: if isSuperAdmin();
    }

    match /fd_inspections_drafts/{draftId} {
      allow read, create, update: if isAuth() && (myRole() == 'FIRE_DETECTION' || myRole() == 'SUPER_ADMIN');
      allow delete: if isSuperAdmin();
    }

    match /fd_incidents/{incidentId} {
      allow read:   if isAuth();
      allow create,
            update: if isAuth() && (myRole() == 'FIRE_DETECTION' || myRole() == 'SUPER_ADMIN');
      allow delete: if isSuperAdmin();
    }

    match /fd_compliance_notifications/{configId} {
      allow read:   if isAuth() && (myRole() == 'FIRE_DETECTION' || myRole() == 'SUPER_ADMIN');
      allow create,
            update: if isAuth() && (myRole() == 'FIRE_DETECTION' || myRole() == 'SUPER_ADMIN');
      allow delete: if isSuperAdmin();
    }

    // ── Everything else: Super Admin only ─────────────────────
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
